# ── ToolsHub backend configuration ──────────────────────────────────────────
# Copy this file to `.env` (e.g. `cp .env.example .env`) and fill in real values.
# NEVER commit the real `.env` — it is git-ignored. Rotate any secret that leaks.

# Port the API server listens on. Must match the app's apiBaseUrl in
# lib/core/config/app_config.dart (dev = http://localhost:5005/api).
PORT=5005

# MongoDB connection string. Paste your MongoDB Atlas URI after the = below.
# Format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/toolshub?retryWrites=true&w=majority
# Leave it EMPTY to run with the built-in in-memory store (data resets on restart).
MONGODB_URI=
# Database name to use when MONGODB_URI is set (defaults to "toolshub").
MONGODB_DB=toolshub

# Default admin account seeded on first run (the store starts otherwise empty).
# Change these to your own before going live.
ADMIN_EMAIL=admin@toolshub.com
ADMIN_PASSWORD=admin123

# Seed a small demo catalog on startup (dev convenience). Set false / remove for
# a completely empty store.
SEED_DEMO=true

# Secret used to sign JWT auth tokens. Use a long, random, unique value.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# How long issued auth tokens stay valid (e.g. 7d, 24h, 30m).
JWT_EXPIRES_IN=7d

# Google Gemini API key for the AI assistant route (optional).
# Leave the placeholder to run without the assistant.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
