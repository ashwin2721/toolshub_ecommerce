# ── ToolsHub backend configuration ──────────────────────────────────────────
# Copy this file to `.env` (e.g. `cp .env.example .env`) and fill in real values.
# NEVER commit the real `.env` — it is git-ignored. Rotate any secret that leaks.

# Port the API server listens on.
PORT=5000

# PostgreSQL connection string (e.g. a Neon database).
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# If this is unreachable the server falls back to an in-memory mock DB.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign JWT auth tokens. Use a long, random, unique value.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# How long issued auth tokens stay valid (e.g. 7d, 24h, 30m).
JWT_EXPIRES_IN=7d

# Google Gemini API key for the AI assistant route (optional).
# Leave the placeholder to run without the assistant.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
