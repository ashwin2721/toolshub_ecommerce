rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.role == 'admin';
    }

    function isStaff() {
      return isSignedIn() && firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.role in ['admin', 'staff_manager', 'inventory_manager'];
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024; // 10MB
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*')
        && request.resource.size < 100 * 1024 * 1024; // 100MB
    }

    // ── Product Images ─────────────────────────────────────────────────
    match /products/{productId}/{allPaths=**} {
      allow read: if true; // Public read
      allow write: if isStaff() && isValidImage();
    }

    // ── Product Videos ─────────────────────────────────────────────────
    match /product_videos/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidVideo();
    }

    // ── User Profile Images ────────────────────────────────────────────
    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
    }

    // ── Banner Images ──────────────────────────────────────────────────
    match /banners/{bannerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // ── Category Images ────────────────────────────────────────────────
    match /categories/{categoryId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // ── Brand Logos ────────────────────────────────────────────────────
    match /brands/{brandId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // ── Invoice PDFs ───────────────────────────────────────────────────
    match /invoices/{userId}/{orderId}/{allPaths=**} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if isStaff();
    }

    // ── Support Ticket Attachments ─────────────────────────────────────
    match /support_attachments/{userId}/{ticketId}/{allPaths=**} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if isOwner(userId) && request.resource.size < 5 * 1024 * 1024;
    }

    // ── Review Images ──────────────────────────────────────────────────
    match /reviews/{productId}/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }
  }
}
